# Copy to `.env` for local development. In production, prefer setting the same variable NAMES
# in your platform's Environment / Application Settings UI — those override `.env` when both exist.

DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Tune under load (defaults 5 / 10 overflow)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email — Gmail SMTP (use an App Password, not your Google account password)
# Guide: https://myaccount.google.com → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
# Optional — defaults to MAIL_USERNAME (must match Gmail login for delivery)
MAIL_FROM=your-email@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
# If 587/STARTTLS fails on your network, try: MAIL_USE_SSL=true and MAIL_PORT=465
# MAIL_USE_SSL=false
# DEBUG only: log OTP in API logs when SMTP fails (disable in production)
# LOG_OTP_ON_SMTP_FAIL=true
# Local dev: put OTP in signup/resend JSON when Gmail never delivers (never enable in production)
# DEV_EXPOSE_OTP_IN_RESPONSE=true

# OTP: multipart MIME same as `python scripts/test_smtp.py` when false; true = plain text only.
OTP_EMAIL_PLAIN_ONLY=false

# Frontend base URL (for invitation links in emails)
FRONTEND_URL=http://localhost:5173
